{
  "name": "@url-sanitize/cli",
  "version": "2.4.1",
  "description": "Command-line tool to remove tracking parameters (utm_*, fbclid, gclid…) and unwrap tracking redirects from URLs and whole text. ClearURLs, Brave and Firefox rules built in.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "url-sanitize": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@url-sanitize/core": "workspace:*",
    "@url-sanitize/merged": "workspace:*"
  },
  "keywords": [
    "cli",
    "url",
    "sanitize",
    "tracking",
    "clearurls",
    "utm",
    "fbclid",
    "gclid",
    "remove-tracking",
    "tracking-parameters",
    "url-cleaner",
    "clean-url",
    "link-cleaner",
    "privacy",
    "command-line"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonio-orionus/url-sanitize.git",
    "directory": "packages/cli"
  },
  "homepage": "https://antonio-orionus.github.io/url-sanitize/"
}
