{
  "name": "@url-sanitize/cli",
  "version": "2.0.1",
  "description": "Command-line tool to remove tracking parameters and unwrap tracking redirects from URLs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "url-sanitize": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/bin.ts --format esm --clean",
    "dev": "tsup src/bin.ts --format esm --watch"
  },
  "dependencies": {
    "@url-sanitize/core": "workspace:*",
    "@url-sanitize/merged": "workspace:*"
  },
  "keywords": [
    "cli",
    "url",
    "sanitize",
    "tracking",
    "clearurls"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonio-orionus/url-sanitize.git",
    "directory": "packages/cli"
  }
}
