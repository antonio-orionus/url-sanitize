{
  "name": "@url-sanitize/fetch",
  "version": "2.0.6",
  "description": "Runtime ClearURLs catalog fetching with SHA256 and optional pinned-hash verification.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@url-sanitize/clearurls": "workspace:*",
    "@url-sanitize/core": "workspace:*"
  },
  "keywords": [
    "clearurls",
    "url",
    "tracking",
    "privacy",
    "fetch"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonio-orionus/url-sanitize.git",
    "directory": "packages/fetch"
  },
  "sideEffects": false
}
