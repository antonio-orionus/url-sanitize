{
  "name": "@url-sanitize/core",
  "version": "2.4.3",
  "description": "Pure TypeScript engine that removes tracking parameters (utm_*, fbclid, gclid…) and unwraps tracking redirects from URLs and text. Zero dependencies; bring a rule catalog.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "keywords": [
    "url",
    "sanitize",
    "tracking",
    "clearurls",
    "privacy",
    "utm",
    "fbclid",
    "gclid",
    "remove-tracking",
    "tracking-parameters",
    "url-cleaner",
    "clean-url",
    "query-string",
    "redirect"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonio-orionus/url-sanitize.git",
    "directory": "packages/core"
  },
  "homepage": "https://antonio-orionus.github.io/url-sanitize/",
  "sideEffects": false
}
