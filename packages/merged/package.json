{
  "name": "@url-sanitize/merged",
  "version": "2.4.0",
  "description": "Merged ClearURLs, Brave, and Firefox catalog for @url-sanitize/core, with optional AdGuard.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@url-sanitize/brave": "workspace:*",
    "@url-sanitize/clearurls": "workspace:*",
    "@url-sanitize/core": "workspace:*",
    "@url-sanitize/firefox": "workspace:*"
  },
  "keywords": [
    "url",
    "sanitize",
    "tracking",
    "clearurls",
    "brave",
    "firefox"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonio-orionus/url-sanitize.git",
    "directory": "packages/merged"
  },
  "sideEffects": false,
  "devDependencies": {
    "@url-sanitize/adguard": "workspace:*"
  }
}
