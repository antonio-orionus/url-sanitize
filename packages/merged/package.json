{
  "name": "@url-sanitize/merged",
  "version": "2.4.1",
  "description": "Remove tracking parameters (utm_*, fbclid, gclid, si…) and unwrap tracking redirects from URLs and text, with the ClearURLs, Brave and Firefox rules in one catalog.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@url-sanitize/brave": "workspace:*",
    "@url-sanitize/clearurls": "workspace:*",
    "@url-sanitize/core": "workspace:*",
    "@url-sanitize/firefox": "workspace:*"
  },
  "keywords": [
    "url",
    "sanitize",
    "tracking",
    "clearurls",
    "brave",
    "firefox",
    "utm",
    "fbclid",
    "gclid",
    "remove-tracking",
    "tracking-parameters",
    "url-cleaner",
    "clean-url",
    "link-cleaner",
    "privacy",
    "redirect"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonio-orionus/url-sanitize.git",
    "directory": "packages/merged"
  },
  "homepage": "https://antonio-orionus.github.io/url-sanitize/",
  "sideEffects": false,
  "devDependencies": {
    "@url-sanitize/adguard": "workspace:*"
  }
}
