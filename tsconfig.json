{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/*/vite.config.ts",
    "sources/**/*",
    "scripts/**/*.ts",
    "conformance/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
