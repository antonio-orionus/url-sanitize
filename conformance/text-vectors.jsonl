{"id":"sentence","note":"a URL between words","input":"Read https://example.com/a?utm_source=x&id=1 today","expected":{"text":"Read https://example.com/a?id=1 today","found":["https://example.com/a?utm_source=x&id=1"]}}
{"id":"trailing-period","note":"sentence punctuation is not part of the URL","input":"See https://example.com/?utm_source=x.","expected":{"text":"See https://example.com/.","found":["https://example.com/?utm_source=x"]}}
{"id":"trailing-punctuation-run","note":"a run of trailing punctuation is trimmed","input":"Wow https://example.com/?fbclid=1!?","expected":{"text":"Wow https://example.com/!?","found":["https://example.com/?fbclid=1"]}}
{"id":"markdown-link","note":"the closing paren of a Markdown link is not part of the URL","input":"[docs](https://example.com/p?utm_medium=x&q=1)","expected":{"text":"[docs](https://example.com/p?q=1)","found":["https://example.com/p?utm_medium=x&q=1"]}}
{"id":"markdown-autolink","note":"angle brackets end the URL","input":"<https://example.com/?utm_source=x>","expected":{"text":"<https://example.com/>","found":["https://example.com/?utm_source=x"]}}
{"id":"balanced-parens-kept","note":"parens that open inside the URL belong to it","input":"https://en.wikipedia.org/wiki/Rust_(language)?utm_source=x","expected":{"text":"https://en.wikipedia.org/wiki/Rust_(language)","found":["https://en.wikipedia.org/wiki/Rust_(language)?utm_source=x"]}}
{"id":"parenthesized-url-with-parens","note":"only the unmatched closing paren is trimmed","input":"(see https://example.com/a_(b)?utm_source=x)","expected":{"text":"(see https://example.com/a_(b))","found":["https://example.com/a_(b)?utm_source=x"]}}
{"id":"square-brackets","note":"an unmatched ] is trimmed","input":"[https://example.com/?utm_source=x]","expected":{"text":"[https://example.com/]","found":["https://example.com/?utm_source=x"]}}
{"id":"double-quoted","note":"a double quote ends the URL","input":"href=\"https://example.com/?utm_source=x\"","expected":{"text":"href=\"https://example.com/\"","found":["https://example.com/?utm_source=x"]}}
{"id":"single-quoted","note":"a trailing single quote is trimmed","input":"'https://example.com/?utm_source=x'","expected":{"text":"'https://example.com/'","found":["https://example.com/?utm_source=x"]}}
{"id":"smart-quotes","note":"curly quotes end the URL","input":"“https://example.com/?utm_source=x”","expected":{"text":"“https://example.com/”","found":["https://example.com/?utm_source=x"]}}
{"id":"ellipsis","note":"U+2026 ends the URL","input":"https://example.com/?utm_source=x…","expected":{"text":"https://example.com/…","found":["https://example.com/?utm_source=x"]}}
{"id":"cjk-punctuation","note":"CJK punctuation ends the URL","input":"链接https://example.com/?utm_source=x。下一句","expected":{"text":"链接https://example.com/。下一句","found":["https://example.com/?utm_source=x"]}}
{"id":"fullwidth-paren","note":"fullwidth parens end the URL","input":"（https://example.com/?utm_source=x）","expected":{"text":"（https://example.com/）","found":["https://example.com/?utm_source=x"]}}
{"id":"backticks","note":"inline code spans","input":"`https://example.com/?utm_source=x`","expected":{"text":"`https://example.com/`","found":["https://example.com/?utm_source=x"]}}
{"id":"emphasis","note":"Markdown emphasis around a URL","input":"_https://example.com/?utm_source=x_","expected":{"text":"_https://example.com/_","found":["https://example.com/?utm_source=x"]}}
{"id":"multiple","note":"every URL is found; unchanged ones are reported too","input":"a https://example.com/x b https://example.org/?fbclid=2 c","expected":{"text":"a https://example.com/x b https://example.org/ c","found":["https://example.com/x","https://example.org/?fbclid=2"]}}
{"id":"uppercase-scheme","note":"the scheme matches case-insensitively","input":"HTTPS://example.com/?utm_source=x","expected":{"text":"https://example.com/","found":["HTTPS://example.com/?utm_source=x"]}}
{"id":"http-scheme","note":"http URLs are found","input":"http://example.com/?utm_source=x","expected":{"text":"http://example.com/","found":["http://example.com/?utm_source=x"]}}
{"id":"after-equals","note":"a URL after a non-alphanumeric character","input":"u=https://example.com/?utm_source=x","expected":{"text":"u=https://example.com/","found":["https://example.com/?utm_source=x"]}}
{"id":"after-letter","note":"a scheme glued to a word is not a URL","input":"xhttps://example.com/?utm_source=x","expected":{"text":"xhttps://example.com/?utm_source=x","found":[]}}
{"id":"scheme-only","note":"a bare scheme is not a URL","input":"https:// and http://.","expected":{"text":"https:// and http://.","found":[]}}
{"id":"other-schemes","note":"only http and https are found","input":"ftp://example.com/?utm_source=x mailto:a@example.com","expected":{"text":"ftp://example.com/?utm_source=x mailto:a@example.com","found":[]}}
{"id":"no-scheme","note":"URLs without a scheme are not found","input":"www.example.com/?utm_source=x","expected":{"text":"www.example.com/?utm_source=x","found":[]}}
{"id":"redirect-unwrapped","note":"a redirect is replaced by its target, and the inner URL is not found again","input":"go https://www.google.com/url?sa=t&q=https%3A%2F%2Fexample.com%2Ftarget now","expected":{"text":"go https://example.com/target now","found":["https://www.google.com/url?sa=t&q=https%3A%2F%2Fexample.com%2Ftarget"]}}
{"id":"redirect-kept-when-disabled","note":"unwrapRedirects: false leaves the redirect in place; its own tracking params still go","options":{"unwrapRedirects":false},"input":"https://www.google.com/url?sa=t&q=https%3A%2F%2Fexample.com%2Ftarget","expected":{"text":"https://www.google.com/url?q=https%3A%2F%2Fexample.com%2Ftarget","found":["https://www.google.com/url?sa=t&q=https%3A%2F%2Fexample.com%2Ftarget"]}}
{"id":"blocked-stays","note":"a blocked URL stays in the text as it was","options":{"domainBlocking":true},"input":"ad https://pagead2.googlesyndication.com/x here","expected":{"text":"ad https://pagead2.googlesyndication.com/x here","found":["https://pagead2.googlesyndication.com/x"]}}
{"id":"crlf","note":"CR and LF end the URL and are kept","input":"a https://example.com/?utm_source=x\r\nb","expected":{"text":"a https://example.com/\r\nb","found":["https://example.com/?utm_source=x"]}}
{"id":"tabs","note":"tabs end the URL and are kept","input":"x\thttps://example.com/?utm_source=x\ty","expected":{"text":"x\thttps://example.com/\ty","found":["https://example.com/?utm_source=x"]}}
{"id":"nbsp","note":"a no-break space ends the URL","input":"https://example.com/?utm_source=x next","expected":{"text":"https://example.com/ next","found":["https://example.com/?utm_source=x"]}}
{"id":"bidi-override","note":"a bidi override ends the URL","input":"https://example.com/?utm_source=x‮gnp.exe","expected":{"text":"https://example.com/‮gnp.exe","found":["https://example.com/?utm_source=x"]}}
{"id":"empty","note":"empty text","input":"","expected":{"text":"","found":[]}}
{"id":"no-urls","note":"text without URLs is returned as is","input":"nothing to see here.","expected":{"text":"nothing to see here.","found":[]}}
